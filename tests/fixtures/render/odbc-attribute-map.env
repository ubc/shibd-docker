# ODBC with the other legacy branch (remote attribute map) and values full of
# sed and template metacharacters. They must reach the XML untouched, exactly
# as the original rocky9 entrypoint rendered them.
SHIBBOLETH_IDP_DISCOVERY_URL=https://idp.example.test/discovery?x=1
SHIBBOLETH_IDP_METADATA_URL=https://idp.example.test/idp/shibboleth
SHIBBOLETH_IDP_ENTITY_ID=https://idp.example.test
SHIBBOLETH_SP_ENTITY_ID=https://sp.example.test/shibboleth
SHIBD_ATTRIBUTE_MAP_URL=https://sp.example.test/attribute-map.xml
SHIBD_LISTENER_ACL=127.0.0.1 10.0.0.0/8
SHIBD_LISTENER_ADDRESS=0.0.0.0
SHIBD_ODBC_DRIVER=MariaDB
SHIBD_ODBC_LIB=odbc-store.so
SHIBD_ODBC_SERVER=db.example.test
SHIBD_ODBC_PORT=3307
SHIBD_ODBC_DATABASE=shibd
SHIB_ODBC_USER=shibd
SHIB_ODBC_PASSWORD=p|a\ss/w0rd##STORAGE_ID####IF_MEMORY##$HOME${PATH}
SHIBBOLETH_COOKIE_PROPS=https
SHIBBOLETH_SESSION_LIFETIME=28800
SHIBD_REMOTE_USER=eppn
LOG_LEVEL=WARN
