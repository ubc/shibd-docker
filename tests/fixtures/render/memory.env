# CWL Pages (pages.ltic.ubc.ca) against the UBC staging IdP: one replica,
# in-memory sessions, IdP metadata from a mounted file.
SHIBBOLETH_SP_ENTITY_ID=https://pages.ltic.ubc.ca/shibboleth
SHIBBOLETH_IDP_ENTITY_ID=https://authentication.stg.id.ubc.ca
SHIBBOLETH_IDP_DISCOVERY_URL=https://authentication.stg.id.ubc.ca
SHIBBOLETH_IDP_METADATA_FILE=/etc/shibboleth/idp/idp-metadata.xml
SHIBD_STORAGE=memory
SHIBBOLETH_HANDLER_SSL=true
SHIBBOLETH_COOKIE_PROPS=https
SHIBD_REMOTE_USER=uid
SHIBD_LISTENER_ADDRESS=127.0.0.1
SHIBD_LISTENER_ACL=127.0.0.1
SHIBBOLETH_SESSION_LIFETIME=7200
SHIBBOLETH_SESSION_TIMEOUT=3600
SHIBBOLETH_CACHE_TIMEOUT=3600
SHIBD_CONSISTENT_ADDRESS=true
LOG_LEVEL=INFO
SHIBBOLETH_HOME_URL=/signed-in
