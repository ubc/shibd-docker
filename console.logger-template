log4j.rootCategory=${LOG_LEVEL}, console

# fairly verbose for DEBUG, so generally leave at INFO
log4j.category.XMLTooling.XMLObject=INFO
log4j.category.XMLTooling.KeyInfoResolver=INFO
log4j.category.Shibboleth.IPRange=INFO
log4j.category.Shibboleth.PropertySet=INFO

# raise for low-level tracing of SOAP client HTTP/SSL behavior
log4j.category.XMLTooling.libcurl=INFO

# useful categories to tune independently:
#
# tracing of SAML messages and security policies
#log4j.category.OpenSAML.MessageDecoder=DEBUG
#log4j.category.OpenSAML.MessageEncoder=DEBUG
#log4j.category.OpenSAML.SecurityPolicyRule=DEBUG
# interprocess message remoting
#log4j.category.Shibboleth.Listener=DEBUG
# mapping of requests to applicationId
#log4j.category.Shibboleth.RequestMapper=DEBUG
# high level session cache operations
#log4j.category.Shibboleth.SessionCache=DEBUG
# persistent storage and caching
#log4j.category.XMLTooling.StorageService=DEBUG

##IF_MEMORY### Login events go to the console with everything else. Without this they stay in
##IF_MEMORY### /var/log/shibboleth/transaction.log inside the container, where the stock
##IF_MEMORY### shibd.logger (read before this file) sends them.
##IF_MEMORY##log4j.category.Shibboleth-TRANSACTION=INFO, console
##IF_MEMORY##log4j.additivity.Shibboleth-TRANSACTION=false
##IF_MEMORY### At INFO the session cache logs every session ID, which is the session cookie's
##IF_MEMORY### value, with the client address ("new session created", "removed session").
##IF_MEMORY##log4j.category.Shibboleth.SessionCache=WARN
##IF_MEMORY##
# define the appender

log4j.appender.console=org.apache.log4j.ConsoleAppender
#log4j.appender.console.layout=org.apache.log4j.BasicLayout
log4j.appender.console.layout=org.apache.log4j.PatternLayout
log4j.appender.console.layout.ConversionPattern=%d{%Y-%m-%d %H:%M:%S} %p %c %x: %m%n
